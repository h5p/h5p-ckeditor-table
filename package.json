{
  "name": "@h5p/ckeditor5-table",
  "version": "0.0.14",
  "description": "The H5P version of the CKEditor 5 table plugin.",
  "keywords": [
    "ckeditor",
    "ckeditor5",
    "ckeditor 5",
    "ckeditor5-feature",
    "ckeditor5-plugin"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-clipboard": "48.1.1",
    "@ckeditor/ckeditor5-core": "48.1.1",
    "@ckeditor/ckeditor5-engine": "48.1.1",
    "@ckeditor/ckeditor5-icons": "48.1.1",
    "@ckeditor/ckeditor5-typing": "48.1.1",
    "@ckeditor/ckeditor5-ui": "48.1.1",
    "@ckeditor/ckeditor5-utils": "48.1.1",
    "@ckeditor/ckeditor5-widget": "48.1.1",
    "es-toolkit": "1.45.1"
  },
  "devDependencies": {
    "@ckeditor/ckeditor5-alignment": "48.1.1",
    "@ckeditor/ckeditor5-autoformat": "48.1.1",
    "@ckeditor/ckeditor5-autosave": "48.1.1",
    "@ckeditor/ckeditor5-basic-styles": "48.1.1",
    "@ckeditor/ckeditor5-block-quote": "48.1.1",
    "@ckeditor/ckeditor5-dev-build-tools": "56.1.0",
    "@ckeditor/ckeditor5-dev-translations": "56.1.0",
    "@ckeditor/ckeditor5-editor-classic": "48.1.1",
    "@ckeditor/ckeditor5-editor-multi-root": "48.1.1",
    "@ckeditor/ckeditor5-essentials": "48.1.1",
    "@ckeditor/ckeditor5-heading": "48.1.1",
    "@ckeditor/ckeditor5-highlight": "48.1.1",
    "@ckeditor/ckeditor5-horizontal-line": "48.1.1",
    "@ckeditor/ckeditor5-html-support": "48.1.1",
    "@ckeditor/ckeditor5-image": "48.1.1",
    "@ckeditor/ckeditor5-indent": "48.1.1",
    "@ckeditor/ckeditor5-link": "48.1.1",
    "@ckeditor/ckeditor5-list": "48.1.1",
    "@ckeditor/ckeditor5-media-embed": "48.1.1",
    "@ckeditor/ckeditor5-paragraph": "48.1.1",
    "@ckeditor/ckeditor5-source-editing": "48.1.1",
    "@ckeditor/ckeditor5-undo": "48.1.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "eslint-config-ckeditor5": "^16.0.0",
    "eslint-plugin-ckeditor5-rules": "^16.0.0",
    "globals": "^16.1.0",
    "json-diff": "^0.5.4",
    "typescript": "5.5.4",
    "vite": "^8.0.0",
    "vitest": "^4.1.7",
    "webdriverio": "^9.19.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/h5p/h5p-ckeditor-table.git"
  },
  "files": [
    "dist",
    "ckeditor5-metadata.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:npm && npm run build:browser",
    "build:npm": "vite build --mode npm",
    "build:browser": "vite build --mode browser",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:debug": "vitest --inspect-brk --no-file-parallelism --browser.headless=false",
    "lint": "eslint",
    "translations:synchronize": "node ./scripts/synchronize-translations.js",
    "translations:validate": "node ./scripts/synchronize-translations.js --validate-only",
    "prepublishOnly": "npm run build"
  }
}
